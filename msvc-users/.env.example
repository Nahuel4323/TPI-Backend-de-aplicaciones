# Configuracion local: formato properties, sin export ni comillas.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5433/users_db
# Completar con las credenciales locales de PostgreSQL.
DB_USERNAME=users
DB_PASSWORD=


# Ejecutar infra/keycloak/configurar-users-registration.ps1 para completar el secreto local.
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=complejos-deportivos
KEYCLOAK_REGISTRATION_CLIENT_ID=users-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=

# Primer administrador: dejar desactivado durante el arranque normal.
BOOTSTRAP_ADMIN_ENABLED=false
# Completar solo para el arranque controlado inicial. No versionar credenciales reales.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NOMBRE=
# BOOTSTRAP_ADMIN_APELLIDO=
# BOOTSTRAP_ADMIN_TELEFONO=
# BOOTSTRAP_ADMIN_TELEFONO_LABORAL=
