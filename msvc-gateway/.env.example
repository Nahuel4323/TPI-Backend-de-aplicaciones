# Configuracion local: formato properties, sin export ni comillas.
SERVER_PORT=8080
USERS_SERVICE_URL=http://localhost:8081
SPACES_SERVICE_URL=http://localhost:8082
BOOKINGS_SERVICE_URL=http://localhost:8083

# La misma clave interna en msvc-users/.env. No es una clave de usuario ni de Keycloak.
GATEWAY_INTERNAL_TOKEN=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/complejos-deportivos
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/complejos-deportivos/protocol/openid-connect/certs
